# === Discord (required) ===
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_USER_IDS=
ALLOWED_CHANNEL_IDS=

# === Web / OAuth (optional: web UI / Activity shell) ===
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=change-me-in-production
WEB_BASE_URL=http://localhost:3000
PORT=3000

# === Database (defaults to local SQLite) ===
# For production with Turso, create a dedicated database for this bot only.
# Do NOT reuse an existing database such as "bot-prod" to avoid data mixing.
# Example:
#   CONTROL_DB_URL=https://discord-bot-template-ORG.turso.io
#   TURSO_TEMPLATE_DB_URL=https://discord-bot-template-ORG.turso.io
CONTROL_DB_URL=file:./data/control.db
CONTROL_DB_TOKEN=
TURSO_TEMPLATE_DB_URL=file:./data/template-guild.db
TURSO_GROUP_TOKEN=

# === Logging ===
LOG_LEVEL=info
