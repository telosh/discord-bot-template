# === Discord (required) ===
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_USER_IDS=
ALLOWED_CHANNEL_IDS=

# === Web / OAuth (optional: web UI / Activity shell) ===
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=change-me-in-production
WEB_BASE_URL=http://localhost:3000
PORT=3000

# === Turso (optional: defaults to local SQLite) ===
